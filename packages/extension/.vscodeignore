# Everything that is not needed at runtime. The extension ships as one
# bundled file, so the sources it was built from stay out.
.vscode/**
src/**
test/**
tsconfig.json
.gitignore
node_modules/**
**/*.map
!dist/extension.js
# MuPDF travels as files rather than inside the bundle — see tools/copy-mupdf.mjs.
!dist/mupdf/**
!media/**
!language-configuration.json
!package.json
!README.md
!CHANGELOG.md
!LICENSE
